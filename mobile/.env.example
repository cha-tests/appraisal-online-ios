# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI API (for property valuations)
# Native (iOS/Android) only — called via a plain REST request, not Google's
# own native SDK, so this key can't be restricted by "iOS apps"/"Android
# apps" in Google Cloud Console (those restriction types only recognize
# requests made through that SDK). Leave this key's Application restriction
# set to None.
EXPO_PUBLIC_GOOGLE_GEMINI_API_KEY=your_gemini_api_key
# Web only — a *separate* key from the one above (a single Google API key's
# Application restriction is one of Websites/IP addresses/Android apps/iOS
# apps/None, never more than one at a time). Restrict this one to Websites
# (HTTP referrer) in Google Cloud Console: localhost:<your dev port>/* for
# local development, plus your production domain(s) once deployed.
EXPO_PUBLIC_GOOGLE_GEMINI_API_KEY_WEB=your_gemini_api_key_restricted_to_your_website

# Stripe (for payments)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Google Places API (for address autocomplete)
# Native only — same reasoning as the Gemini key above (plain REST call,
# Application restriction left at None).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key
# Web only — loaded via the Google Maps JavaScript API instead of the REST
# API (see services/placesWeb.service.ts), restricted to Websites (HTTP
# referrer) the same way as the Gemini web key above. Needs both "Maps
# JavaScript API" and "Places API" enabled in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY_WEB=your_places_api_key_restricted_to_your_website

# Backend API (the deployed Express service in backend/, e.g. your Render
# URL). Used for emailing the PDF report, and other server-side calls.
# Falls back to http://localhost:3001 if unset, which only works on your
# own machine during local development.
EXPO_PUBLIC_API_URL=https://your-backend.onrender.com
