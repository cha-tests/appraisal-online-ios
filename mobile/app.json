{
  "expo": {
    "name": "Appraisal Online",
    "slug": "appraisal-online",
    "version": "0.1.0",
    "scheme": "appraisalonline",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appraisalonline.mobile",
      "buildNumber": "16",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to find comparable properties",
        "NSCameraUsageDescription": "Appraisal Online uses your camera to scan your card during checkout and to take verification photos during broker signup.",
        "NSPhotoLibraryUsageDescription": "Appraisal Online needs access to your photos so you can upload a valid ID during broker signup.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appraisalonline.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d2a1906f-3e0a-43b8-be81-301f159d0c80"
      }
    },
    "owner": "chatests-team",
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.appraisal.online",
          "enableGooglePay": false
        }
      ],
      "expo-font",
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
