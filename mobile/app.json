{
  "expo": {
    "name": "Appraisal Online",
    "slug": "appraisal-online",
    "version": "0.1.0",
    "scheme": "appraisalonline",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appraisalonline.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to find comparable properties",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.appraisalonline.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "d2a1906f-3e0a-43b8-be81-301f159d0c80"
      }
    },
    "owner": "chatests-team",
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.appraisal.online",
          "enableGooglePay": false
        }
      ]
    ]
  }
}
