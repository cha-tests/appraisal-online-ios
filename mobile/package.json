  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3"
  }
