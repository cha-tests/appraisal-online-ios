{
  "name": "appraisal-online-mobile",
  "version": "0.1.0",
  "description": "Appraisal Online React Native mobile app",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "dev:phone": "EXPO_TOKEN= EXPO_PACKAGER_PROXY_URL=https://$CODESPACE_NAME-8090.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN expo start --port 8090",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/bodoni-moda": "^0.4.2",
    "@react-native-community/masked-view": "0.1.11",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-navigation/native": "^7.1.8",
    "@stripe/stripe-react-native": "0.85.1",
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.0",
    "base64-js": "^1.5.1",
    "expo": "^58.0.25",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-store-review": "~58.0.3",
    "jpeg-js": "^0.4.4",
    "posthog-react-native": "^4.86.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-maps": "1.29.11",
